# Copy to .env next to docker-compose.yaml and fill in.

# Runs the bundled Ollama. Remove it (leave empty) when HBA_EMBEDDINGS_BASE_URL points elsewhere.
COMPOSE_PROFILES=ollama

# Image to run; pin a version tag (e.g. 1.2.0) instead of latest for repeatable deploys.
HBA_IMAGE_TAG=latest
HBA_PORT=8080

# Homebox (>= 0.27). Must be reachable from inside the container: use the host's LAN address or
# a hostname, not localhost. Prefer an API key; username/password also works.
HBA_HOMEBOX_URL=http://homebox.lan:7745
HBA_HOMEBOX_API_KEY=
HBA_HOMEBOX_USERNAME=
HBA_HOMEBOX_PASSWORD=
# Custom fields whose values are product codes, comma separated.
HBA_HOMEBOX_CODE_FIELDS=EAN,UPC,Barcode,GTIN,SKU

# Used in a connection URL, so keep it URL-safe: openssl rand -hex 24
POSTGRES_PASSWORD=

# Any OpenAI-compatible /v1/embeddings endpoint. Defaults to the bundled Ollama.
# Bifrost example: HBA_EMBEDDINGS_BASE_URL=http://bifrost:8080/v1, HBA_EMBEDDINGS_MODEL=ollama/nomic-embed-text
HBA_EMBEDDINGS_BASE_URL=http://ollama:11434/v1
HBA_EMBEDDINGS_API_KEY=
HBA_EMBEDDINGS_MODEL=nomic-embed-text

HBA_SYNC_INTERVAL=10m
HBA_MATCHING_MIN_SIMILARITY=0.75
HBA_MATCHING_MIN_MARGIN=0.03

# OTLP export (traces, metrics, logs).
HBA_OBSERVABILITY_ENABLED=false
HBA_OBSERVABILITY_ENDPOINT=
HBA_OBSERVABILITY_PROTOCOL=grpc
